{
  "name": "@omniknowledge/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OmniKnowledge web frontend (rewrite of the KnowledgeLab iPad Demo against the CiteClaw backend).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify-transplants": "node scripts/verify-transplants.mjs && node scripts/generate-build-jsx.mjs --check",
    "parity-states": "node parity/run-state-parity.mjs",
    "generate-build-jsx": "node scripts/generate-build-jsx.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "parse5": "^8.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
